rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Yardımcı fonksiyonlar
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Profil resimleri
    match /profile-images/{userId} {
      allow read: if true; // Herkes görebilir
      allow write: if isOwner(userId) && 
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                      request.resource.contentType.matches('image/.*');
    }
    
    // Banner resimleri
    match /banners/{userId} {
      allow read: if true; // Herkes görebilir
      allow write: if isOwner(userId) && 
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                      request.resource.contentType.matches('image/.*');
    }
    
    // Liste kapak görselleri
    match /list-covers/{listId}/{allPaths=**} {
      allow read: if true; // Herkes görebilir
      allow write: if isSignedIn() && 
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                      request.resource.contentType.matches('image/.*');
    }
    
    // Anime altyazıları
    match /anime-subtitles/{animeId}/{allPaths=**} {
      allow read: if true; // Herkes indirebilir
      allow write: if isSignedIn() && 
                      request.resource.size < 10 * 1024 * 1024 && // 10MB limit
                      (request.resource.contentType.matches('text/.*') || 
                       request.resource.contentType.matches('application/.*'));
    }
    
    // Genel yükleme klasörü (moderatörler için)
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && 
                      request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
    
    // Varsayılan: Erişim yok
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
