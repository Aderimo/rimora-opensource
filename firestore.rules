rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== YARDIMCI FONKSYONLAR ===== //
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isFounder() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/moderators/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.role == 'founder';
    }
    
    function isModerator() {
      return isSignedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.role in ['founder', 'admin', 'moderator'];
    }
    
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/moderators/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.role in ['founder', 'admin'];
    }
    
    function isBanned() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'banned';
    }
    
    function canInteract() {
      return isSignedIn() && !isBanned();
    }
    
    function isRecentTimestamp() {
      return request.resource.data.timestamp == request.time;
    }

    // ===== KULLANICI YÖNETİMİ ===== //
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isModerator());
      allow delete: if isFounder();
      
      match /badges/{badgeId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isOwner(userId);
      }
      
      match /watchProgress/{progressId} {
        allow read, list: if isOwner(userId);
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
      
      match /watchedEpisodes/{episodeId} {
        allow read, list: if isOwner(userId);
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
    match /userLists/{listId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    match /customLists/{listId} {
      allow read: if isOwner(resource.data.userId) || isModerator();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
    }
    
    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(subscriptionId);
      allow write: if false; 
    }
    
    match /user_settings/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    
    match /userStats/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }
    
    match /user_stats/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }
    
    match /user_badges/{badgeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
    
    match /activities/{activityId} {
      allow read: if true;
      allow create: if canInteract() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
    }

    // ===== İÇERİK & PUANLAMA ===== //
    match /content/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
      
      // Review likes subcollection
      match /likes/{likeId} {
        allow read: if true;
        allow create: if isSignedIn() && likeId == request.auth.uid;
        allow delete: if isOwner(likeId);
      }
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
    }
    
    match /comment_likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }

    match /lists/{listId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId) || isModerator();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
    }
    
    match /list_items/{itemId} {
      allow read: if true;
      allow create: if canInteract() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /favorites/{favoriteId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /watch_history/{historyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }
    
    match /watchlist/{watchId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /watchProgress/{progressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ===== SOSYAL & DİĞER ===== //
    match /follows/{followId} {
      allow read: if true;
      allow create: if canInteract() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isOwner(resource.data.followerId);
    }
    
    match /friends/{friendshipId} {
      allow read: if isSignedIn();
      allow create: if canInteract();
      allow delete: if isSignedIn();
    }
    
    match /friend_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if canInteract() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isSignedIn();
    }
    
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if canInteract() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && 
        request.auth.uid in resource.data.participants &&
        // Pin limit validation (max 30)
        (!request.resource.data.keys().hasAny(['pinnedMessages']) || 
         request.resource.data.pinnedMessages.size() <= 30);
    }
    
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if canInteract() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Mesaj sahibi kendi mesajını düzenleyebilir
        (request.auth.uid == resource.data.senderId && 
         request.resource.data.keys().hasAny(['content', 'isEdited', 'lastEditedAt', 'editHistory'])) ||
        // Conversation participant'ları mesajı sabitleyebilir
        (request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants &&
         request.resource.data.keys().hasAny(['pinnedBy'])) ||
        // Genel güncelleme (read status vb.)
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants
      ) && 
      // pinnedBy ve editedBy validation
      (!request.resource.data.keys().hasAny(['pinnedBy']) || 
       request.auth.uid in request.resource.data.pinnedBy) &&
      (!request.resource.data.keys().hasAny(['editHistory']) || 
       request.resource.data.editHistory.size() == 0 ||
       request.resource.data.editHistory[request.resource.data.editHistory.size() - 1].editedBy == request.auth.uid);
      allow delete: if isOwner(resource.data.senderId) || isModerator();
    }
    
    // ===== KULLANICI ENGELLEMESİ (Gelecek Özellik) ===== //
    match /blocks/{blockId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.blockerId || 
        isModerator()
      );
      allow create: if canInteract() && 
                       request.resource.data.blockerId == request.auth.uid &&
                       request.resource.data.blockerId != request.resource.data.blockedId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.blockerId;
      allow update: if false;
    }
    
    // ===== KULLANICI ÖNERİLERİ CACHE (Gelecek Özellik) ===== //
    match /userRecommendations/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn();
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read, create, update, delete: if isSignedIn();
    }
    
    match /notificationSettings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /subtitleSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /moderators/{modId} {
      allow read: if true;
      allow create, update, delete: if isFounder();
    }
    
    match /reports/{reportId} {
      allow read: if isModerator() || isOwner(resource.data.reportedBy);
      allow create: if canInteract() && request.resource.data.reportedBy == request.auth.uid;
      allow update: if isModerator();
    }
    
    match /bans/{banId} {
      allow read: if isModerator() || isOwner(resource.data.userId);
      allow create, update: if isModerator();
      allow delete: if isFounder();
    }

    match /watch-party-rooms/{roomId} {
      allow read: if true;
      allow create: if canInteract() && request.resource.data.hostId == request.auth.uid;
      allow update: if canInteract();
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;
    }
    
    match /watch-party-messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if canInteract() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
    }

    match /pageViews/{document} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isRecentTimestamp();
    }
    
    match /onlineUsers/{document} {
      allow read, write: if isSignedIn();
    }
    
    match /dailyStats/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /errorLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ===== DESTEK & GERİBİLDİRİM ===== //
    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid &&
                       request.resource.data.priority in ['low', 'medium', 'high'];
      allow update: if isModerator() || isOwner(resource.data.userId);
      allow delete: if isModerator() || isOwner(resource.data.userId);
      
      // Destek talepleri mesajları
      match /messages/{messageId} {
        allow read: if isSignedIn() && (isModerator() || get(/databases/$(database)/documents/feedbacks/$(feedbackId)).data.userId == request.auth.uid);
        allow create: if isSignedIn() && 
                         !get(/databases/$(database)/documents/feedbacks/$(feedbackId)).data.isClosed && 
                         (get(/databases/$(database)/documents/feedbacks/$(feedbackId)).data.userId == request.auth.uid || isModerator());
        allow update, delete: if isModerator() || request.auth.uid == resource.data.senderId;
      }
    }
    
    match /content_requests/{requestId} {
      allow read: if isModerator() || isOwner(resource.data.userId);
      allow create: if canInteract() && request.resource.data.userId == request.auth.uid;
      allow update: if isModerator();
      allow delete: if isOwner(resource.data.userId) || isModerator();
    }

    // ===== ÖDEME & ABONELİK ===== //
    match /refundRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isFounder();
    }
    
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // Sadece server-side
    }
    
    match /pushSubscriptions/{subscriptionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    match /contentSubscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }

    // ===== UYARILAR & CEZALAR ===== //
    match /warnings/{warningId} {
      allow read: if isModerator() || isOwner(resource.data.userId);
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }
    
    match /mutes/{muteId} {
      allow read: if isModerator() || isOwner(resource.data.userId);
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }
    
    match /appeals/{appealId} {
      allow read: if isModerator() || isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // ===== CEZA YÖNETİMİ ===== //
    match /penalties/{userId} {
      allow read: if isModerator() || isOwner(userId);
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }

    match /bulkActions/{actionId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isFounder();
    }

    match /scheduledActionLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /emailQueue/{emailId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ===== MOD ODALARI ===== //
    match /mod_rooms/{roomId} {
      allow read: if isModerator();
      allow create, update: if isAdmin();
      allow delete: if isFounder();
      
      // Oda mesajları - moderatörler yazıp okuyabilir
      match /messages/{messageId} {
        allow read: if isModerator();
        allow create: if isModerator() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isModerator() && request.auth.uid == resource.data.senderId;
      }
    }

    // ===== VARSAYILAN KURAL ===== //
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
