# =============================================================================
# RIMORA - Environment Variables
# =============================================================================
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE - Client-side (NEXT_PUBLIC_ prefix)
# Firebase Console > Project Settings > General > Your apps > SDK setup
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Cloud Messaging (Push Notifications)
# Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# -----------------------------------------------------------------------------
# FIREBASE ADMIN - Server-side (Push Notifications için)
# Firebase Console > Project Settings > Service accounts > Generate new private key
# JSON dosyasını base64 encode edin veya içeriğini olduğu gibi yapıştırın
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# TMDB API
# https://www.themoviedb.org/settings/api adresinden API key alın
# NOT: Bu server-side kullanılır, NEXT_PUBLIC_ prefix kullanmayın
# -----------------------------------------------------------------------------
TMDB_API_KEY=

# -----------------------------------------------------------------------------
# IYZICO - Ödeme Sistemi
# iyzico Merchant Panel'den API anahtarlarını alın
# Sandbox için: https://sandbox-merchant.iyzipay.com
# Production için: https://merchant.iyzipay.com
# -----------------------------------------------------------------------------
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox: https://sandbox-api.iyzipay.com
# Production: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# -----------------------------------------------------------------------------
# EMAIL - Resend
# https://resend.com/api-keys adresinden API key alın
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rimora.com
RESEND_FROM_NAME=Rimora

# -----------------------------------------------------------------------------
# VIDEO KAYNAKLARI
# -----------------------------------------------------------------------------
# Proje hiçbir video kaynağı ile birlikte gelmez. Oynatıcının çalışması için
# kendi kaynaklarınızı burada tanımlamanız gerekir.
#
# ÖNEMLİ: Yalnızca yayın hakkına sahip olduğunuz ya da size bu hakkı veren
# kaynakları bağlayın. Bağladığınız içeriklerin hukuki sorumluluğu size aittir.
#
# Format: JSON dizisi. Şablon değişkenleri: {tmdbId} {season} {episode}
# Tanımsız bırakılırsa oynatıcı "kaynak yapılandırılmamış" durumunu gösterir.
#
# Örnek:
# NEXT_PUBLIC_VIDEO_SOURCES='[{"id":"kendi-cdn","name":"Sunucu 1","quality":"1080p","language":"TR","priority":1,"movie":"https://cdn.example.com/movie/{tmdbId}","tv":"https://cdn.example.com/tv/{tmdbId}/{season}/{episode}"}]'
NEXT_PUBLIC_VIDEO_SOURCES=

# -----------------------------------------------------------------------------
# SITE CONFIG
# -----------------------------------------------------------------------------
# Production URL'iniz (SEO, meta tags, sitemap için)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WEBHOOK SECURITY
# Webhook endpoint'leri için güvenlik ayarları
# -----------------------------------------------------------------------------
# Dakikada maksimum webhook isteği sayısı (default: 60)
WEBHOOK_RATE_LIMIT=60

# İzin verilen IP adresleri (virgülle ayrılmış, boş bırakılırsa tüm IP'ler izinli)
# Örnek: 192.168.1.0/24,10.0.0.1,203.0.113.*
WEBHOOK_ALLOWED_IPS=

# Webhook imza doğrulaması zorunlu mu (default: true)
WEBHOOK_REQUIRE_SIGNATURE=true

# -----------------------------------------------------------------------------
# OPTIONAL - API Security
# Dahili API çağrıları için güvenlik anahtarı (opsiyonel)
# -----------------------------------------------------------------------------
# API_SECRET_KEY=your-secret-key-here
